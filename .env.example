# Copy to .env to override defaults used by docker-compose.yml.
# ALL values below are DEVELOPMENT defaults. Never reuse them in production.

ENVIRONMENT=development
MONGO_URI=mongodb://database:27017/?replicaSet=rs0
MONGO_DB_NAME=minishop
JWT_SECRET=dev-only-change-me-please-0123456789abcdef

# Development-only scenario/fault-injection endpoints (/api/v1/dev/*).
# Forced OFF when ENVIRONMENT=production.
ENABLE_DEV_SCENARIOS=true

# Seed credentials (development only)
SEED_ADMIN_EMAIL=admin@minishop.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_PASSWORD=Customer@12345

# APP-R-056 monitoring
MONITOR_WINDOW_SECONDS=60
TRACE_SAMPLE_RATE=0.2

CORS_ORIGINS=http://localhost:3000

# Optional JSON overrides (see docs/PERFORMANCE_MONITORING.md)
# ABSOLUTE_LIMITS_JSON={"GET /api/v1/products/{product_id}": 3000}
# ENDPOINT_THRESHOLDS_JSON={"POST /api/v1/orders": {"avg_factor": 3.0}}
